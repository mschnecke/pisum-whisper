<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- The development default. Every release overrides it from the tag: `release.yml`
         strips the `v` and passes -p:Version=$VERSION to publish, and the same string to the
         WiX build, the Info.plist substitution, the pkgbuild version argument and the nuspec,
         so one version reaches every artifact of a release (design D8). -->
    <Version>0.1.0</Version>
  </PropertyGroup>

</Project>
