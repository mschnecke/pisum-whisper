<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Host">
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="UI">
    <PackageVersion Include="Avalonia" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!-- Proven by the change 1 spikes; first referenced by changes 4, 6 and 7. Pinned here so the
       spikes and the production code that follows them cannot drift apart. -->
  <ItemGroup Label="Platform stack">
    <PackageVersion Include="SharpHook" Version="8.0.0" />
    <PackageVersion Include="SoundFlow" Version="1.4.1" />
    <PackageVersion Include="Concentus" Version="2.2.2" />
    <PackageVersion Include="Concentus.Oggfile" Version="1.0.7" />
  </ItemGroup>

  <!-- Serilog.Sinks.Console is not optional despite the console sink being #if DEBUG only: a
       PackageReference conditioned on the configuration would not restore reliably, and the release
       build simply never references the sink. -->
  <ItemGroup Label="Logging">
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <!-- The xunit.v3 pin is load-bearing. Avalonia.Headless.XUnit 12.1.1 is compiled against
       xunit.v3 3.2.2 and declares xunit.v3.extensibility.core [3.2.2, ) - an open upper bound, so
       nothing stops NuGet resolving 4.0.0 against a major the package was not built for. Moving it
       breaks the settings window's headless tests rather than anything here. -->
  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.1" />
    <PackageVersion Include="FakeItEasy" Version="9.0.1" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="SharpHook.Testing" Version="8.0.0" />
  </ItemGroup>

</Project>
