<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Pisum.Whisper.App.Notifications.ToastWindow"
        x:CompileBindings="True"
        Width="360"
        Height="96"
        ShowActivated="False"
        Topmost="True"
        ShowInTaskbar="False"
        WindowDecorations="None"
        CanResize="False"
        Background="#1E1E1E">

    <!-- Explicit brushes rather than a theme. App loads FluentTheme for the settings window, which
         pins ThemeVariant.Light on itself because a dark theme is an untested non-goal; a
         notification overlay reads as a dark card on both platforms by convention, so declaring its
         appearance outright sidesteps that question rather than reopening it. -->
    <Border BorderThickness="1"
            BorderBrush="#3C3C3C"
            Padding="16,14">
        <StackPanel Spacing="6" VerticalAlignment="Center">
            <TextBlock x:Name="TitleText"
                       FontSize="14"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       Foreground="White" />
            <TextBlock x:Name="MessageText"
                       FontSize="12"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="3"
                       Foreground="#BEBEBE" />
        </StackPanel>
    </Border>

</Window>
