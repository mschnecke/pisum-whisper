<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <!-- Pinned since change 1 and referenced by nothing until now: the tray icon never needed a
         theme, and the settings window is the first thing in this application with controls in it. -->
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pisum.Whisper.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pisum.Whisper.Core\Pisum.Whisper.Core.csproj" />
    <ProjectReference Include="..\Pisum.Whisper.Platform\Pisum.Whisper.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- The .win.svg / .mac.svg sources the PNGs are exported from. Nothing reads them at runtime,
         so keeping them out of the assembly saves ~7 KB of resource. -->
    <AvaloniaResource Remove="Assets\*.svg" />
  </ItemGroup>

</Project>
